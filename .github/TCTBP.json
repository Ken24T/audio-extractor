{
  "schemaVersion": 8,
  "governance": {
    "sourceOfTruth": "TCTBP.json",
    "fallbackDocument": "TCTBP Agent.md",
    "templateMode": false,
    "templateInstructions": "This repository uses the TCTBP workflow as a repo-specific profile. Preserve the audio-extractor repo's Cargo workspace version source, bare semver tag format, Rust-first verification commands, release build scripts, migration docs, and default branch when updating these files."
  },
  "project": {
    "name": "audio-extractor",
    "description": "Rust-first cross-platform audio extraction CLI and egui desktop GUI for Windows and Linux with ffmpeg integration.",
    "defaultBranch": "master",
    "versionFiles": ["Cargo.toml"],
    "changelogFormat": "keep-a-changelog",
    "locale": "en-AU"
  },
  "profile": {
    "commands": {
      "format": null,
      "test": "cargo test --workspace",
      "lint": null,
      "build": "cargo check --workspace",
      "releaseBuild": "cargo build --release -p extractor-cli -p extractor-gui"
    },
    "qualityGates": {
      "requireZeroProblems": true,
      "requireTestsBeforeShip": true,
      "requireLintBeforeShip": false,
      "requireBuildBeforeShip": true
    },
    "versioning": {
      "sourceOfTruth": "Cargo.toml:workspace.package.version",
      "tagFormat": "{version}"
    },
    "releaseBuildPolicy": "explicit-installation-or-deployment-only"
  },
  "activation": {
    "triggers": [
      "ship",
      "ship please",
      "shipping",
      "prepare release",
      "publish",
      "publish please",
      "deploy",
      "deploy please",
      "handover",
      "handover please",
      "resume",
      "resume please",
      "status",
      "status please",
      "abort"
    ],
    "caseInsensitive": true,
    "branchCommand": {
      "enabled": true,
      "pattern": "^branch\\s+(.+)$",
      "stopIfTargetBranchExistsLocal": true,
      "stopIfTargetBranchExistsRemote": true,
      "stopIfTargetBranchEqualsDefault": true,
      "stopIfTargetBranchInvalid": true
    }
  },
  "ship": {
    "preferredTriggers": ["ship", "ship please", "shipping", "prepare release"],
    "requireFetchedOriginInPreflight": true,
    "stopIfDetachedHead": true,
    "stopIfBranchMissingUpstream": false,
    "allowShipFromUnpublishedBranch": true,
    "createUpstreamOnFirstPublish": true,
    "stopIfBranchBehindUpstream": true,
    "stopIfBranchDiverged": true,
    "stopIfWorkingTreeDirty": true,
    "purpose": "Create a formal shipped version from a clean, fetched branch, allowing first-time publication from a clean unpublished branch while keeping Cargo workspace version, tags, and remote state recoverable and unambiguous."
  },
  "publish": {
    "preferredTriggers": ["publish", "publish please"],
    "requireFetchedOriginInPreflight": true,
    "stopIfDetachedHead": true,
    "requireCleanTree": true,
    "stopIfBranchMissingUpstream": false,
    "createUpstreamOnFirstPublish": true,
    "stopIfBranchBehindUpstream": true,
    "stopIfBranchDiverged": true,
    "pushTagsWhenPresent": false,
    "purpose": "Safely publish the current clean branch to origin, including first publication when no upstream exists yet, without bumping version, creating tags, or updating handover metadata."
  },
  "workflow": {
    "shipOrder": ["preflight", "verify", "problems", "docs-impact", "bump", "commit", "changelog", "tag", "push"],
    "publishOrder": ["preflight", "fetch", "report", "verify-gate", "push-if-needed", "verify-sync", "summary"],
    "branchOrder": ["preflight", "assess-ship", "verify-or-stop", "inspect-source-branch", "sync-default-branch", "confirm-merge-into-default-when-needed", "merge-source-into-default-when-needed", "verify-transition", "create-new-branch", "optional-cleanup", "summary"],
    "handoverOrder": ["preflight", "fetch", "inspect-current-branch", "compare", "stage", "checkpoint-if-needed", "verify-gate", "docs-impact", "commit-if-needed", "reconcile", "push-if-needed", "update-handover-metadata", "verify-sync", "summary"],
    "resumeOrder": ["preflight", "fetch", "read-handover-metadata", "determine-target-branch", "switch-target-branch", "reconcile-read-only", "verify-ready-state", "summary"],
    "statusOrder": ["fetch", "report", "recommend"],
    "abortOrder": ["inspect", "propose", "execute"],
    "deployOrder": ["preflight", "sync-prerequisite", "verification-gate", "docs-impact", "runtime-build", "deploy-target", "post-deploy-validation", "summary"],
    "requireApproval": ["push"]
  },
  "shipReport": {
    "enabled": true,
    "stage": "preflight",
    "format": "table",
    "columns": ["Origin", "Local", "Status", "Action(s)"],
    "recommendedRows": [
      "branch-and-upstream",
      "head-commit",
      "last-shipped-tag",
      "commits-ahead-behind",
      "working-tree",
      "version-source",
      "docs-impact",
      "push-readiness"
    ],
    "comment": "At the start of SHIP, render a concise release-focused local-versus-origin snapshot table before making changes. Use 'n/a' where a row has no meaningful origin-side value."
  },
  "statusReport": {
    "enabled": true,
    "stage": "report",
    "format": "table",
    "columns": ["Origin", "Local", "Status", "Action(s)"],
    "recommendedRows": [
      "branch-and-upstream",
      "head-commit",
      "default-branch-state",
      "last-shipped-tag",
      "commits-ahead-behind",
      "working-tree",
      "version-source",
      "handover-metadata",
      "ship-readiness",
      "handover-readiness"
    ],
    "comment": "For status, render the fuller local-versus-origin operator snapshot. Include the current branch, default branch, tags, ahead/behind state, and handover relevance. Use 'n/a' where no meaningful origin-side value exists."
  },
  "handoverReport": {
    "enabled": true,
    "stage": "summary",
    "format": "table",
    "columns": ["Origin", "Local", "Status", "Action(s)"],
    "recommendedRows": [
      "current-branch-state",
      "last-shipped-tag",
      "metadata-branch-state",
      "metadata-consistency",
      "handover-baseline"
    ],
    "comment": "At the end of handover, render a concise five-row summary table that confirms the current branch, tag state, metadata branch publication, metadata consistency, and clean synced baseline. Keep it shorter than status and focused on the handover result."
  },
  "branch": {
    "enabled": true,
    "purpose": "Safely close out the current published branch, reconcile the default branch, and create the next work branch without losing code.",
    "defaultBranch": "master",
    "stopIfDetachedHead": true,
    "validateTargetBranchNameBeforeWorkflow": true,
    "stopIfTargetBranchExistsLocal": true,
    "stopIfTargetBranchExistsRemote": true,
    "stopIfTargetBranchEqualsDefault": true,
    "stopIfTargetBranchInvalid": true,
    "requiresCleanTreeBeforeSwitch": true,
    "stopIfDirtyAndShipDeclined": true,
    "stopIfSourceBranchAheadOfUpstream": true,
    "stopIfSourceBranchDiverged": true,
    "stopIfSourceBranchBehindUpstream": true,
    "stopIfDefaultBranchDiverged": true,
    "allowFastForwardDefaultBranchWhenClean": true,
    "mergeSourceIntoDefaultWhenSourceIsNotDefault": true,
    "requireConfirmationBeforeMergeIntoDefaultWhenSourceIsNotDefault": true,
    "mergeIntoDefaultIsExpectedOutcome": true,
    "defaultMergeIntoDefaultAnswer": "yes",
    "stopIfMergeIntoDefaultDeclined": true,
    "skipMergeWhenAlreadyOnDefaultBranch": true,
    "useNonDestructiveMerge": true,
    "stopOnMergeConflict": true,
    "requireSourceBranchPublishedBeforeTransition": true,
    "recommendHandoverWhenSourceBranchUnsynced": true,
    "requireSourceCommitReachableFromDefaultBeforeCleanup": true,
    "requireNewBranchCreatedBeforeCleanup": true,
    "allowLocalBranchDeletion": true,
    "allowRemoteBranchDeletion": true,
    "requireExplicitApprovalForPush": true,
    "requireExplicitApprovalForDeletion": true,
    "neverUseStashResetOrRebase": true,
    "summaryMustConfirmNoCodeLossGuards": true
  },
  "handover": {
    "preferredTriggers": ["handover", "handover please"],
    "purpose": "Safely checkpoint and publish the current work branch at end of day, then refresh the handover metadata branch so another machine can resume from a deterministic shared state.",
    "syncScope": "current-work-branch-plus-handover-metadata-and-relevant-tags",
    "metadataBranch": "tctbp/handover-state",
    "metadataFile": ".github/TCTBP_STATE.json",
    "stopIfDetachedHead": true,
    "updateMetadataBranchOnSuccessfulHandover": true,
    "metadataBranchUpdateStrategy": "secondary-worktree",
    "createDurableCheckpointBeforeVerificationWhenDirty": true,
    "checkpointPurpose": "Preserve unpublished dirty work before verification or reconciliation can block handover, using a clearly marked non-release checkpoint commit or other repo-approved durable checkpoint.",
    "stopIfCheckpointDeclinedForDirtyUnpublishedWork": true,
    "allowFastForwardWhenBehindAndClean": true,
    "stopWhenBehindAndDirty": true,
    "allowAutoMerge": false,
    "allowAutoRebase": false,
    "allowHardReset": false,
    "allowDestructiveCheckout": false,
    "allowForcePush": false,
    "mergeDefaultBranchDuringHandover": false,
    "pushCurrentBranchWhenAhead": true,
    "pushTagsWhenPresent": true
  },
  "resume": {
    "preferredTriggers": ["resume", "resume please"],
    "purpose": "Restore the intended work branch at start of day by consulting handover metadata first, switching safely when needed, and reconciling only through non-destructive checkout and fast-forward operations.",
    "metadataBranch": "tctbp/handover-state",
    "metadataFile": ".github/TCTBP_STATE.json",
    "stopIfDetachedHead": true,
    "consultMetadataBranchBeforeBranchInference": true,
    "preferMetadataOverCleanNonDefaultBranch": true,
    "currentBranchMayOverrideMetadataOnlyWhenDescendantOfMetadataCommit": true,
    "excludeBranchesFromCandidateDetection": ["origin/master", "origin/HEAD", "origin/tctbp/handover-state"],
    "requiresConfirmationWhenSwitchingBranches": true,
    "stopOnAmbiguousTargetBranch": true,
    "createLocalTrackingBranchFromRemoteWhenMissing": true,
    "allowFastForwardWhenBehindAndClean": true,
    "stopWhenBehindAndDirty": true,
    "stopWhenLocalAhead": true,
    "allowAutoMerge": false,
    "allowAutoRebase": false,
    "allowHardReset": false,
    "allowDestructiveCheckout": false,
    "allowForcePush": false,
    "pushNeverDuringResume": true
  },
  "abort": {
    "preferredTriggers": ["abort"],
    "requireExplicitApprovalForAllActions": true,
    "requireDoubleConfirmationForHistoryRewrite": true,
    "partialStates": [
      "version-bumped-without-tag",
      "tag-created-not-pushed",
      "branch-pushed-metadata-stale",
      "metadata-pushed-branch-unpublished",
      "main-pushed-new-branch-unpublished",
      "new-branch-pushed-master-unpublished",
      "old-remote-branch-deleted-before-transition-complete",
      "merge-in-progress",
      "changelog-updated-without-version-bump",
      "local-remote-tag-drift"
    ],
    "purpose": "Detect partial workflow states and recover safely without discarding unpublished work or rewriting history implicitly."
  },
  "statusRecommendations": {
    "enabled": true,
    "suggestions": ["resume", "publish", "handover", "ship", "abort", "none"],
    "rules": {
      "resume": "Suggest when the current machine is not yet on the intended handed-over work branch, the metadata points at a different published branch than the current clean branch, or the safest next action is to restore the last handed-over branch before doing new work.",
      "publish": "Suggest when the current branch is clean, ahead of origin or missing an upstream, and the user likely wants to publish the branch safely without creating release version or handover metadata side effects.",
      "handover": "Suggest when the active work branch must be left in a durable shared state for another machine or another session, especially when branch publication and handover metadata should be refreshed together before stopping work.",
      "ship": "Suggest when there are unshipped commits since the last tag or version and tag drift exists.",
      "abort": "Suggest when a partial workflow state is detected.",
      "none": "Suggest when branch state is clean, synced, and no SHIP or handover is needed."
    }
  },
  "docsInfraPolicy": {
    "skipSteps": ["test", "build"],
    "keepSteps": ["preflight", "problems-editor", "docs-impact", "commit", "push"],
    "filePatterns": ["*.md", "*.txt", "*.rst", "docs/**", ".github/**", "PLAN.md", "LICENSE*", "CHANGELOG*", "CONTRIBUTING*"],
    "comment": "For docs-only or infrastructure-only changes: skip heavy verification commands, keep editor diagnostics and docs impact assessment."
  },
  "documentation": {
    "requireImpactAssessment": true,
    "blockShipIfUnassessed": true,
    "allowNoDocChangeWithReason": true,
    "changeTypes": [
      "user-visible-feature",
      "ui-or-interaction",
      "config-or-settings",
      "packaging-or-metadata",
      "roadmap-or-status",
      "internal-only"
    ],
    "rules": [
      {
        "changeType": "user-visible-feature",
        "review": ["README.md", "docs/UserGuide.md"]
      },
      {
        "changeType": "ui-or-interaction",
        "review": ["README.md", "docs/UserGuide.md"]
      },
      {
        "changeType": "config-or-settings",
        "review": ["README.md", "docs/UserGuide.md"]
      },
      {
        "changeType": "packaging-or-metadata",
        "review": ["README.md", "docs/UserGuide.md", "Cargo.toml", "scripts/build-rust-artifacts.sh", "scripts/build-rust-artifacts.ps1"]
      },
      {
        "changeType": "roadmap-or-status",
        "review": ["README.md", "docs/MigrationNotes.md", "PLAN.md"]
      },
      {
        "changeType": "internal-only",
        "review": []
      }
    ],
    "comment": "Also review migration docs when behaviour or stack expectations change."
  },
  "deploy": {
    "preferredTriggers": ["deploy", "deploy please"],
    "purpose": "Deploy is repo-specific and should be used only for explicit current-platform release artifact builds.",
    "stopIfDetachedHead": true,
    "requireCleanTree": true,
    "requireSyncedBranch": true,
    "requireShipFirst": false,
    "requireRollbackPlanForDestructiveDeploy": true,
    "buildCommand": "cargo build --release -p extractor-cli -p extractor-gui",
    "migrationCommand": null,
    "targets": {
      "current-platform-artifacts": {
        "description": "Build current-platform release binaries for the CLI and GUI using the repo's release helper scripts.",
        "installCommand": "./scripts/build-rust-artifacts.sh",
        "postDeployChecks": [
          "test -d target/release",
          "test -f target/release/extractor-cli || test -f target/release/extractor-cli.exe"
        ]
      }
    }
  },
  "versioning": {
    "scheme": "semver",
    "patchEveryShip": true,
    "skipForChangeTypes": ["docs-only", "infrastructure-only", "migration-slice"],
    "minorOnFirstShipOfBranch": true,
    "minorBranchPrefixes": ["feature/", "slice/"],
    "majorExplicitOnly": true
  },
  "tagging": {
    "policy": "everyCommit",
    "skipWhenNoBump": true,
    "format": "{version}"
  }
}